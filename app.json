{
  "_comment": "This file is generated. Please edit .homeycompose/app.json instead.",
  "id": "community.birdbuddy",
  "version": "1.4.0",
  "compatibility": ">=12.3.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Bird Buddy",
    "nl": "Bird Buddy"
  },
  "description": {
    "en": "See every bird that visits your feeder",
    "nl": "Zie elke vogel die je voederhuisje bezoekt"
  },
  "category": [
    "appliances"
  ],
  "permissions": [],
  "author": {
    "name": "Tim Vandendriessche",
    "email": "Tim.Homeyapps@outlook.com"
  },
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "brandColor": "#2E7D32",
  "support": "mailto:Tim.Homeyapps@outlook.com",
  "flow": {
    "triggers": [
      {
        "title": {
          "en": "A bird was identified",
          "nl": "Er is een vogel herkend"
        },
        "hint": {
          "en": "Triggers once a new postcard's bird species are known, including automatic identification for free Bird Buddy accounts. Uses the configured check interval.",
          "nl": "Gaat af zodra de vogelsoorten van een nieuwe ansichtkaart bekend zijn, ook bij automatische herkenning voor gratis Bird Buddy-accounts. Gebruikt het ingestelde controle-interval."
        },
        "tokens": [
          {
            "name": "species",
            "type": "string",
            "title": {
              "en": "Bird species",
              "nl": "Vogelsoort"
            },
            "example": "European Robin"
          },
          {
            "name": "time",
            "type": "string",
            "title": {
              "en": "Time of visit",
              "nl": "Tijdstip bezoek"
            },
            "example": "2026-10-19T08:15:00.000Z"
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=feeder"
          }
        ],
        "id": "bird_identified"
      },
      {
        "title": {
          "en": "Daily summary is ready",
          "nl": "Het dagoverzicht is klaar"
        },
        "hint": {
          "en": "Triggers once a day at the hour set in the feeder settings, with the visits of that day, for example to send a notification. Does not trigger on a day without visits.",
          "nl": "Gaat één keer per dag af op het uur dat je in de instellingen van het voederhuisje kiest, met de bezoeken van die dag, bijvoorbeeld om een melding te sturen. Gaat niet af op een dag zonder bezoeken."
        },
        "tokens": [
          {
            "name": "summary",
            "type": "string",
            "title": {
              "en": "Summary",
              "nl": "Overzicht"
            },
            "example": "12× Great Tit, 3× European Robin"
          },
          {
            "name": "total",
            "type": "number",
            "title": {
              "en": "Visits today",
              "nl": "Bezoeken vandaag"
            },
            "example": 15
          },
          {
            "name": "species",
            "type": "number",
            "title": {
              "en": "Different species",
              "nl": "Verschillende soorten"
            },
            "example": 2
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=feeder"
          }
        ],
        "id": "daily_summary"
      },
      {
        "title": {
          "en": "A new bird species was seen",
          "nl": "Een nieuwe vogelsoort is gezien"
        },
        "hint": {
          "en": "Triggers the first time a species is seen at your feeder. The very first species counted only sets the starting point.",
          "nl": "Gaat af de eerste keer dat een soort bij je voederhuisje wordt gezien. De allereerste getelde soort vormt enkel het startpunt."
        },
        "tokens": [
          {
            "name": "species",
            "type": "string",
            "title": {
              "en": "Bird species",
              "nl": "Vogelsoort"
            },
            "example": "Eurasian Blue Tit"
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=feeder"
          }
        ],
        "id": "new_species"
      },
      {
        "title": {
          "en": "No visitors for a while",
          "nl": "Al een tijd geen bezoekers"
        },
        "titleFormatted": {
          "en": "No visitor for [[hours]] hours",
          "nl": "Al [[hours]] uur geen bezoeker"
        },
        "hint": {
          "en": "Triggers once when no bird has visited for the given number of hours, for example to remind you to refill the feeder. Birds usually stay away at night, so choose a long period. Triggers again after the next visit.",
          "nl": "Gaat één keer af wanneer er het opgegeven aantal uren geen vogel langskwam, bijvoorbeeld als herinnering om het voederhuisje bij te vullen. 's Nachts komen er meestal geen vogels, kies dus een lange periode. Gaat opnieuw af na het volgende bezoek."
        },
        "tokens": [
          {
            "name": "hours",
            "type": "number",
            "title": {
              "en": "Hours without a visit",
              "nl": "Uren zonder bezoek"
            },
            "example": 24
          },
          {
            "name": "last_visit",
            "type": "string",
            "title": {
              "en": "Time of the last visit",
              "nl": "Tijdstip laatste bezoek"
            },
            "example": "2026-10-22T08:15:00.000Z"
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=feeder"
          },
          {
            "type": "number",
            "name": "hours",
            "title": {
              "en": "Hours",
              "nl": "Uren"
            },
            "placeholder": {
              "en": "24",
              "nl": "24"
            },
            "min": 1,
            "max": 720,
            "step": 1
          }
        ],
        "id": "no_visitors"
      },
      {
        "title": {
          "en": "A rare bird visited",
          "nl": "Een zeldzame vogel kwam langs"
        },
        "titleFormatted": {
          "en": "A species visited that was seen at most [[times]] times",
          "nl": "Een soort kwam langs die hoogstens [[times]] keer is gezien"
        },
        "hint": {
          "en": "Triggers when a species visits that you have seen only a few times, counting this visit. Counts cover the period set in the feeder settings.",
          "nl": "Gaat af wanneer een soort langskomt die je pas een paar keer zag, dit bezoek meegeteld. De tellers omvatten de periode die je in de instellingen van het voederhuisje kiest."
        },
        "tokens": [
          {
            "name": "species",
            "type": "string",
            "title": {
              "en": "Bird species",
              "nl": "Vogelsoort"
            },
            "example": "Hawfinch"
          },
          {
            "name": "count",
            "type": "number",
            "title": {
              "en": "Times seen",
              "nl": "Aantal keer gezien"
            },
            "example": 2
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=feeder"
          },
          {
            "type": "number",
            "name": "times",
            "title": {
              "en": "At most",
              "nl": "Hoogstens"
            },
            "placeholder": {
              "en": "3",
              "nl": "3"
            },
            "min": 1,
            "max": 1000,
            "step": 1
          }
        ],
        "id": "rare_visitor"
      },
      {
        "title": {
          "en": "A visit milestone was reached",
          "nl": "Een mijlpaal aan bezoeken is bereikt"
        },
        "titleFormatted": {
          "en": "[[species]] reached a multiple of [[every]] visits",
          "nl": "[[species]] bereikte een veelvoud van [[every]] bezoeken"
        },
        "hint": {
          "en": "Triggers when the visit count is 50, 100, 150... (for \"every 50\"). Choose \"Any species\" to count all birds together. Counts cover the period set in the feeder settings.",
          "nl": "Gaat af wanneer het aantal bezoeken 50, 100, 150... is (bij \"om de 50\"). Kies \"Elke soort\" om alle vogels samen te tellen. De tellers omvatten de periode die je in de instellingen van het voederhuisje kiest."
        },
        "tokens": [
          {
            "name": "species",
            "type": "string",
            "title": {
              "en": "Bird species",
              "nl": "Vogelsoort"
            },
            "example": "European Robin"
          },
          {
            "name": "count",
            "type": "number",
            "title": {
              "en": "Visits of this species",
              "nl": "Bezoeken van deze soort"
            },
            "example": 50
          },
          {
            "name": "total",
            "type": "number",
            "title": {
              "en": "Visits of all birds",
              "nl": "Bezoeken van alle vogels"
            },
            "example": 420
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=feeder"
          },
          {
            "type": "autocomplete",
            "name": "species",
            "title": {
              "en": "Bird species",
              "nl": "Vogelsoort"
            },
            "placeholder": {
              "en": "Choose a species",
              "nl": "Kies een soort"
            }
          },
          {
            "type": "number",
            "name": "every",
            "title": {
              "en": "Every",
              "nl": "Om de"
            },
            "placeholder": {
              "en": "50",
              "nl": "50"
            },
            "min": 1,
            "max": 100000,
            "step": 1
          }
        ],
        "id": "species_milestone"
      },
      {
        "title": {
          "en": "A bird species visited",
          "nl": "Een vogelsoort kwam langs"
        },
        "titleFormatted": {
          "en": "[[species]] visited",
          "nl": "[[species]] kwam langs"
        },
        "hint": {
          "en": "Triggers for every identified visit of the chosen species, also when several birds arrived between two checks. Choose \"Any species\" to trigger for all birds.",
          "nl": "Gaat af bij elk herkend bezoek van de gekozen soort, ook als er tussen twee controles meerdere vogels langskwamen. Kies \"Elke soort\" om voor alle vogels af te gaan."
        },
        "tokens": [
          {
            "name": "species",
            "type": "string",
            "title": {
              "en": "Bird species",
              "nl": "Vogelsoort"
            },
            "example": "European Robin"
          },
          {
            "name": "count_today",
            "type": "number",
            "title": {
              "en": "Visits today",
              "nl": "Bezoeken vandaag"
            },
            "example": 3
          },
          {
            "name": "count_total",
            "type": "number",
            "title": {
              "en": "Visits in total",
              "nl": "Bezoeken in totaal"
            },
            "example": 50
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=feeder"
          },
          {
            "type": "autocomplete",
            "name": "species",
            "title": {
              "en": "Bird species",
              "nl": "Vogelsoort"
            },
            "placeholder": {
              "en": "Choose a species",
              "nl": "Kies een soort"
            }
          }
        ],
        "id": "species_visited"
      },
      {
        "title": {
          "en": "A new visitor arrived",
          "nl": "Er is een nieuwe bezoeker"
        },
        "hint": {
          "en": "Triggers when the feeder has a new visitor photo. Checked every 15 minutes.",
          "nl": "Gaat af als de feeder een nieuwe bezoekersfoto heeft. Wordt elke 15 minuten gecontroleerd."
        },
        "tokens": [
          {
            "name": "image",
            "type": "image",
            "title": {
              "en": "Photo",
              "nl": "Foto"
            }
          },
          {
            "name": "time",
            "type": "string",
            "title": {
              "en": "Time of visit",
              "nl": "Tijdstip bezoek"
            },
            "example": "2026-10-04T08:15:00.000Z"
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=feeder"
          }
        ],
        "id": "visitor_arrived"
      }
    ],
    "conditions": [
      {
        "title": {
          "en": "A visitor came in the last few minutes",
          "nl": "Er was een bezoeker in de laatste minuten"
        },
        "titleFormatted": {
          "en": "A visitor came in the last [[minutes]] minutes",
          "nl": "Er was een bezoeker in de laatste [[minutes]] minuten"
        },
        "hint": {
          "en": "True if the feeder saw a visitor within the given number of minutes. Visitors are detected at the check interval.",
          "nl": "Waar als de feeder een bezoeker zag binnen het opgegeven aantal minuten. Bezoekers worden gezien op het controle-interval."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=feeder"
          },
          {
            "type": "number",
            "name": "minutes",
            "title": {
              "en": "Minutes",
              "nl": "Minuten"
            },
            "placeholder": {
              "en": "60",
              "nl": "60"
            },
            "min": 1,
            "max": 10080,
            "step": 1
          }
        ],
        "id": "visitor_within"
      }
    ]
  },
  "drivers": [
    {
      "name": {
        "en": "Feeder",
        "nl": "Voederhuisje"
      },
      "class": "sensor",
      "capabilities": [
        "measure_battery",
        "last_species",
        "visits_today"
      ],
      "energy": {
        "batteries": [
          "INTERNAL"
        ]
      },
      "platforms": [
        "local"
      ],
      "connectivity": [
        "cloud"
      ],
      "pair": [
        {
          "id": "login",
          "template": "login_credentials",
          "options": {
            "usernameLabel": {
              "en": "Email",
              "nl": "E-mail"
            },
            "usernamePlaceholder": {
              "en": "you@example.com",
              "nl": "jij@voorbeeld.nl"
            },
            "passwordLabel": {
              "en": "Password",
              "nl": "Wachtwoord"
            }
          }
        },
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "icon": "/drivers/feeder/assets/icon.svg",
      "images": {
        "small": "/drivers/feeder/assets/images/small.png",
        "large": "/drivers/feeder/assets/images/large.png",
        "xlarge": "/drivers/feeder/assets/images/xlarge.png"
      },
      "settings": [
        {
          "type": "group",
          "label": {
            "en": "Feeder",
            "nl": "Voederhuisje"
          },
          "children": [
            {
              "id": "auto_identify",
              "type": "checkbox",
              "label": {
                "en": "Automatically identify birds",
                "nl": "Vogels automatisch herkennen"
              },
              "hint": {
                "en": "Uses Bird Buddy's manual Identify request for new postcards, including free accounts. Identification happens at the check interval. Does not save or share postcards.",
                "nl": "Gebruikt Bird Buddy's handmatige herkenningsverzoek voor nieuwe ansichtkaarten, ook bij gratis accounts. Herkenning gebeurt op het controle-interval. Slaat geen ansichtkaarten op en deelt ze niet."
              },
              "value": false
            },
            {
              "id": "species_language",
              "type": "dropdown",
              "label": {
                "en": "Language of bird names",
                "nl": "Taal van de vogelnamen"
              },
              "hint": {
                "en": "Bird Buddy only provides English names. Common garden birds are translated; other species stay in English.",
                "nl": "Bird Buddy geeft alleen Engelse namen. Gewone tuinvogels worden vertaald, andere soorten blijven Engels."
              },
              "value": "auto",
              "values": [
                {
                  "id": "auto",
                  "label": {
                    "en": "Same as Homey",
                    "nl": "Zoals Homey"
                  }
                },
                {
                  "id": "en",
                  "label": {
                    "en": "English",
                    "nl": "Engels"
                  }
                },
                {
                  "id": "nl",
                  "label": {
                    "en": "Dutch",
                    "nl": "Nederlands"
                  }
                },
                {
                  "id": "de",
                  "label": {
                    "en": "German",
                    "nl": "Duits"
                  }
                },
                {
                  "id": "fr",
                  "label": {
                    "en": "French",
                    "nl": "Frans"
                  }
                }
              ]
            },
            {
              "id": "poll_interval",
              "type": "number",
              "label": {
                "en": "Check interval",
                "nl": "Controle-interval"
              },
              "hint": {
                "en": "How often Bird Buddy is checked. Shorter means faster updates but more requests to Bird Buddy.",
                "nl": "Hoe vaak Bird Buddy wordt gecontroleerd. Korter geeft snellere updates, maar meer verzoeken aan Bird Buddy."
              },
              "value": 15,
              "min": 5,
              "max": 120,
              "units": {
                "en": "minutes",
                "nl": "minuten"
              }
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Statistics",
            "nl": "Statistieken"
          },
          "children": [
            {
              "id": "stats_retention_months",
              "type": "number",
              "label": {
                "en": "Keep visit statistics for",
                "nl": "Bezoekstatistieken bewaren gedurende"
              },
              "hint": {
                "en": "Visits per bird species are counted for as long as you set here. Older days are removed. 0 means nothing is ever removed. Only identified birds are counted, so turn on \"Automatically identify birds\" on a free Bird Buddy account.",
                "nl": "Bezoeken per vogelsoort worden geteld voor de periode die je hier instelt. Oudere dagen worden verwijderd. 0 betekent dat er nooit iets wordt verwijderd. Alleen herkende vogels worden geteld, zet daarom \"Vogels automatisch herkennen\" aan bij een gratis Bird Buddy-account."
              },
              "value": 24,
              "min": 0,
              "max": 240,
              "units": {
                "en": "months",
                "nl": "maanden"
              }
            },
            {
              "id": "count_non_birds",
              "type": "checkbox",
              "label": {
                "en": "Also count things that are not birds",
                "nl": "Ook dingen tellen die geen vogel zijn"
              },
              "hint": {
                "en": "Bird Buddy sometimes recognises a fly. These are left out of the statistics unless you tick this.",
                "nl": "Bird Buddy herkent soms een vlieg. Die laat de app weg uit de statistieken, tenzij je dit aanvinkt."
              },
              "value": false
            },
            {
              "id": "summary_hour",
              "type": "number",
              "label": {
                "en": "Send the daily summary at",
                "nl": "Dagoverzicht sturen om"
              },
              "hint": {
                "en": "The hour of the day (0-23, Homey time) at which the Flow trigger \"Daily summary is ready\" fires.",
                "nl": "Het uur van de dag (0-23, tijd van je Homey) waarop de Flow-trigger \"Het dagoverzicht is klaar\" afgaat."
              },
              "value": 20,
              "min": 0,
              "max": 23,
              "units": {
                "en": "o'clock",
                "nl": "uur"
              }
            },
            {
              "id": "stats_reimport",
              "type": "checkbox",
              "label": {
                "en": "Fetch history from Bird Buddy again",
                "nl": "Historiek opnieuw ophalen bij Bird Buddy"
              },
              "hint": {
                "en": "On the first connection the visit counts Bird Buddy already has are copied automatically. Tick this to do that again, for example after you made the keeping period longer. It switches itself off when done and replaces the current numbers.",
                "nl": "Bij de eerste verbinding worden de bezoektellers die Bird Buddy al heeft automatisch overgenomen. Vink dit aan om dat opnieuw te doen, bijvoorbeeld nadat je de bewaartermijn langer maakte. Het vinkje gaat zelf weer uit als het klaar is en vervangt de huidige aantallen."
              },
              "value": false
            }
          ]
        }
      ],
      "repair": [
        {
          "id": "login",
          "template": "login_credentials",
          "options": {
            "usernameLabel": {
              "en": "Email",
              "nl": "E-mail"
            },
            "usernamePlaceholder": {
              "en": "you@example.com",
              "nl": "jij@voorbeeld.nl"
            },
            "passwordLabel": {
              "en": "Password",
              "nl": "Wachtwoord"
            }
          }
        }
      ],
      "id": "feeder"
    }
  ],
  "widgets": {
    "last_visitor": {
      "name": {
        "en": "Last visitor",
        "nl": "Laatste bezoeker"
      },
      "height": "133%",
      "transparent": false,
      "api": {
        "getPhoto": {
          "method": "GET",
          "path": "/"
        },
        "getVideo": {
          "method": "GET",
          "path": "/video"
        }
      },
      "id": "last_visitor",
      "settings": []
    },
    "visit_stats": {
      "name": {
        "en": "Visitor statistics",
        "nl": "Bezoekstatistieken"
      },
      "height": 340,
      "transparent": false,
      "api": {
        "getStatistics": {
          "method": "GET",
          "path": "/"
        }
      },
      "id": "visit_stats",
      "settings": []
    }
  },
  "capabilities": {
    "last_species": {
      "type": "string",
      "title": {
        "en": "Last identified bird",
        "nl": "Laatst herkende vogel"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/last_species.svg"
    },
    "visits_today": {
      "type": "number",
      "title": {
        "en": "Visits today",
        "nl": "Bezoeken vandaag"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "decimals": 0,
      "insights": true,
      "icon": "/assets/last_species.svg"
    }
  }
}